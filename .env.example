DATABASE_URL=sqlite:///./data/jobs.db
PROFILE_PATH=data/profile.json
CLASSIFIER_BACKEND=laya
LAYA_DEVICE=
LINKEDIN_PROFILE_DIR=~/.linkedin-laya/profile
LINKEDIN_HEADLESS=true
LINKEDIN_DELAY_SECONDS=1.0
LINKEDIN_NAV_TIMEOUT_MS=30000
GEEKHUNTER_BASE_URL=https://www.geekhunter.com
GEEKHUNTER_DELAY_SECONDS=1.0
GEEKHUNTER_PAGE_SIZE=25
GEEKHUNTER_TIMEOUT_S=30.0
GUPY_BASE_URL=https://portal.gupy.io
GUPY_DELAY_SECONDS=1.0
GUPY_PAGE_SIZE=10
GUPY_TIMEOUT_S=30.0

# Credencial da API GraphQL da Indeed (chave pública do app oficial).
# Obrigatória: sem ela a fonte recusa a busca antes de qualquer requisição
# e o sync reporta o erro só pra Indeed.
INDEED_API_KEY=
# Mercado (headers indeed-co / indeed-locale): sem eles, outro país responde.
INDEED_CO=BR
INDEED_LOCALE=pt-BR
INDEED_BASE_URL=https://apis.indeed.com
INDEED_DELAY_SECONDS=1.0
INDEED_PAGE_SIZE=25
INDEED_TIMEOUT_S=30.0
# Requisições de transporte que falham são repetidas com backoff exponencial
# + jitter (0 = sem retry).
INDEED_MAX_RETRIES=2
INDEED_BACKOFF_SECONDS=5.0
# Glassdoor bloqueia HTTP direto (Cloudflare 403): coleta via browser local.
# Headless leva o desafio "Um momento…" nesta máquina — mantenha false.
GLASSDOOR_BASE_URL=https://www.glassdoor.com
GLASSDOOR_DELAY_SECONDS=2.0
GLASSDOOR_TIMEOUT_MS=30000
GLASSDOOR_HEADLESS=false
# Sync: descarta publicações mais antigas que N horas (0 = mantém todas).
# Default 30 dias; o seletor do dashboard sobrescreve por requisição.
HOURS_OLD=720
# Sync: pausa de cortesia entre fontes (0 = nenhuma).
SYNC_DELAY_SECONDS=1.0
